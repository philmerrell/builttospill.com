---
import { nav, stores } from '../data/site';
import Wordmark from './Wordmark.astro';

const here = Astro.url.pathname;
const isCurrent = (href: string) => here === href || here.startsWith(href);
---

<header class="site-header">
  <div class="wrap site-header__in">
    <a class="site-header__brand" href="/" aria-label="Built to Spill, home">
      <Wordmark />
    </a>
    <nav class="site-nav" aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="site-nav__store" href={stores[0].href} target="_blank" rel="noopener">
        Merch <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens the store)</span>
      </a>
    </nav>
  </div>
</header>
