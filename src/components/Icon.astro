---
/** Tiny inline icon set. Drawn blunt and filled to sit with the wordmark. */
interface Props {
  name: keyof typeof paths;
  class?: string;
}
const paths = {
  play: '<path d="M6 3.5v17l14-8.5z"/>',
  pause: '<path d="M5 4h5v16H5zM14 4h5v16h-5z"/>',
  next: '<path d="M4 4.5v15l10-7.5zM16 4h4v16h-4z"/>',
  prev: '<path d="M20 4.5v15L10 12zM4 4h4v16H4z"/>',
  expand: '<path d="M3 3h8v3H6v5H3zM21 21h-8v-3h5v-5h3z"/>',
  shrink: '<path d="M11 11H3V8h5V3h3zM13 13h8v3h-5v5h-3z"/>',
  theatre: '<path d="M2 5h20v14H2zm3 3v8h14V8z" fill-rule="evenodd"/>',
  close: '<path d="M5.6 3.5 12 9.9l6.4-6.4 2.1 2.1L14.1 12l6.4 6.4-2.1 2.1L12 14.1l-6.4 6.4-2.1-2.1L9.9 12 3.5 5.6z"/>',
  arrow: '<path d="M13 4.5 20.5 12 13 19.5l-2.1-2.1 3.9-3.9H3.5v-3h11.3l-3.9-3.9z"/>',
  back: '<path d="M11 4.5 3.5 12l7.5 7.5 2.1-2.1-3.9-3.9h11.3v-3H9.2l3.9-3.9z"/>',
  out: '<path d="M8 4h12v12h-3V9.1L6.1 20 4 17.9 14.9 7H8z"/>',
  spin: '<path d="M12 2a10 10 0 1 0 10 10h-3a7 7 0 1 1-7-7z"/>',
  ticket: '<path d="M2 6h20v4a2 2 0 0 0 0 4v4H2v-4a2 2 0 0 0 0-4zm12 2v8h2V8z" fill-rule="evenodd"/>',
} as const;
const { name, class: cls } = Astro.props;
---

<svg class={cls} viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false" set:html={paths[name]} />
